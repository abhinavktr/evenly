# Copy to .env and fill in. All EXPO_PUBLIC_* values are bundled into the app (none are secrets).
EXPO_PUBLIC_API_URL=https://<your-function-app>.azurewebsites.net/api
EXPO_PUBLIC_ENTRA_TENANT_ID=<external-tenant-guid>
EXPO_PUBLIC_ENTRA_SUBDOMAIN=<your-tenant-subdomain>
EXPO_PUBLIC_ENTRA_CLIENT_ID=<app-registration-client-id>
# "entra" for real sign-in; "dev" only when pointing at a local API started with AUTH_MODE=dev
EXPO_PUBLIC_AUTH_MODE=entra
